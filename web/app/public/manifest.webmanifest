{
  "name": "MyMemos",
  "short_name": "MyMemos",
  "description": "A client for your self-hosted Memos server",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f1ece4",
  "theme_color": "#1f6f5c",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "New memo", "url": "/?content=%20", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "/#/tasks", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
